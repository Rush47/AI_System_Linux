# AI Linux Control Center — example values only, never commit secrets
OLLAMA_URL=http://ollama:11434
SYSTEM_AI_MODEL=thox-ai/thoxopen-8b-heretic:q4_k_m
SYSTEM_AI_FALLBACK_MODEL=maternion/spark-x2.5-heretic:4b

# Third-tier fallback: only after both local Ollama models fail.
# Copy to a private .env / container secrets configuration.
GEMINI_FALLBACK_ENABLED=false
GEMINI_API_KEY=
# Verify the exact model ID available to your Google AI Studio project.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Fleet registry: use a persistent mounted volume, not /tmp, in production.
FLEET_DATA_PATH=/data/ai-linux-fleet.json
# Set a long random secret privately; required for all fleet writes.
FLEET_WRITE_TOKEN=

# Authenticated device telemetry ingress; keep secret on server/device only.
FLEET_TELEMETRY_TOKEN=

# Sensor gateway token; set privately, never commit a real secret.
FLEET_SENSOR_TOKEN=

# Shared prototype device token for polling/ack; replace with per-ship credentials before production.
FLEET_DEVICE_TOKEN=

# Persist research/botany data on a mounted volume.
SHIP_LABS_DATA_PATH=/data/ai-linux-labs.json

# Persist the fleet application catalog and device reports on a mounted volume.
FLEET_APPS_DATA_PATH=/data/ai-linux-fleet-apps.json

# OpenAI API and GitHub (server only). ChatGPT subscription does not supply an API key.
INTEGRATIONS_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GITHUB_TOKEN=
GITHUB_REPOSITORY=Rush47/AI_System_Linux

# Optional original-agent task bridge; only configure real verified endpoints.
AGENT_DISPATCH_TOKEN=
AGENT_OUTBOUND_TOKEN=
AGENT_INGEST_TOKEN=
ARIA_TASK_URL=
ALEX_TASK_URL=
ASTYRIA_TASK_URL=
AURELIUS_TASK_URL=
AGENT_TASKS_PATH=/data/ai-linux-agent-tasks.jsonl
AGENT_TASK_RESULTS_PATH=/data/ai-linux-agent-delivery.jsonl
AGENT_INBOX_PATH=/data/ai-linux-agent-inbox.jsonl
