# Copy this file to the repository root as .env and replace every placeholder.
# Keep .env private; it is ignored by Git.
HOST_BIND_IP=127.0.0.1
HOST_PORT=3080

# Generate each value independently with: openssl rand -hex 32
CREDS_KEY=REPLACE_WITH_64_HEX_CHARACTERS
JWT_SECRET=REPLACE_WITH_64_HEX_CHARACTERS
JWT_REFRESH_SECRET=REPLACE_WITH_64_HEX_CHARACTERS
MEILI_MASTER_KEY=REPLACE_WITH_64_HEX_CHARACTERS

# Generate with: openssl rand -hex 16
CREDS_IV=REPLACE_WITH_32_HEX_CHARACTERS

# Optional. OpenAI API billing is separate from ChatGPT subscriptions.
OPENAI_API_KEY=

# Keep registration on only until the first administrator account is created.
ALLOW_REGISTRATION=true
DEBUG_LOGGING=false

# 8K is a sensible CPU-only default for this deployment.
OLLAMA_CONTEXT_LENGTH=8192
